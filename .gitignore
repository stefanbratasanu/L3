# === Toolchain & binaries (portable, machine-local — never committed) ===
# NOTE: tools live at C:\Agentic\tools (outside this repo) but ignore any local copy too.
/tools/
*.zip
*.7z

# === Local LLM models & runtime (large, machine-local) ===
/llm/models/
*.gguf
*.bin
/llm/bin/

# === MariaDB data directory (machine-local state) ===
# Anchored to repo root ONLY — must NOT match server/dist/game/data (the game data pack).
/data/
/server/dist/game/data-local/

# === Java / Ant build outputs ===
*.class
/server/bin/
/server/build/
/server/libs/build/
# Ant build staging output (the assembled server); regenerated by `ant`.
/server/build/dist/

# NOTE: We intentionally KEEP:
#   - server/dist/**            (the game data pack + configs — required to run)
#   - server/dist/libs/*.jar    (HikariCP, mysql-connector, slf4j — runtime deps)
#   - server/dist/**/*.jar

# === Server runtime logs & generated hex id (regenerated on boot) ===
/server/dist/game/log/
/server/dist/login/log/
*.log
/server/dist/game/config/hexid.txt

# === IDE / OS cruft ===
.idea/
*.iml
.vscode/
Thumbs.db
desktop.ini
*.swp
*~

# === Local env overrides & secrets (keep env.ps1 template; ignore local secrets) ===
env.local.ps1
*.pat
*.token
github-token.txt
